{
  "name": "@xixi/dsh-todo",
  "version": "0.1.0",
  "private": true,
  "description": "Web GUI 里的待办清单页面：侧边栏一个入口 + 一整页可增删勾选的待办列表",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "todo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xixi0v0/dsh-todo.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
